{
  "title": "elabs / Whisper STT",
  "description": "OpenAI Whisper large-v3 speech-to-text transcription supporting 100+ languages. Input: {audio_b64, language} \u2192 Output: {text, segments, language, wall_time_s}.",
  "category": "audio",
  "type": "serverless",
  "iconUrl": "https://pub-796a08821c1c483aaf5e274e0d03e350.r2.dev/hub-icons/whisper.svg",
  "config": {
    "runsOn": "GPU",
    "containerDiskInGb": 20,
    "gpuCount": 1,
    "gpuIds": "ADA_24,ADA_48_PRO,AMPERE_24",
    "allowedCudaVersions": [
      "12.8",
      "12.7",
      "12.6",
      "12.5",
      "12.4",
      "12.3",
      "12.2",
      "12.1",
      "12.0"
    ],
    "env": [
      {
        "key": "HF_HOME",
        "value": "/runpod-volume/models/huggingface"
      },
      {
        "key": "WHISPER_MODEL",
        "value": "openai/whisper-large-v3"
      }
    ]
  }
}
{
  "name": "elabs / Whisper STT",
  "description": "OpenAI Whisper large-v3 for speech-to-text. Supports 100+ languages, diarization, word-level timestamps, and multiple output formats (text, SRT, VTT, JSON). API: POST JSON with {audio_base64, language, response_format, temperature} -> {text, segments, language, wall_time_s}. GPU: runs on any GPU with >=4GB VRAM (T4, L4, RTX 4090, etc.).",
  "type": "serverless",
  "task": "audio-to-text",
  "category": "audio",

  "config": {
    "runsOn": "GPU",
    "containerDiskInGb": 20,
    "gpuCount": 1,
    "gpuIds": "ADA_24,ADA_48,AMPERE_48,TURING_16",
    "allowedCudaVersions": [
      "12.8", "12.7", "12.6", "12.5", "12.4", "12.3", "12.2", "12.1", "12.0"
    ],

    "env": [
      {
        "key": "PYTORCH_CUDA_ALLOC_CONF",
        "value": "expandable_segments:True"
      },
      {
        "key": "WHISPER_MODEL",
        "value": "large-v3"
      }
    ],

    "presets": [
      {
        "name": "Fast (base model)",
        "defaults": {
          "WHISPER_MODEL": "base",
          "WHISPER_TEMPERATURE": "0.0"
        }
      },
      {
        "name": "Quality (large-v3)",
        "defaults": {
          "WHISPER_MODEL": "large-v3",
          "WHISPER_TEMPERATURE": "0.0"
        }
      }
    ]
  }
}
